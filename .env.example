# Aplomado Core Shell - Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# All secrets and sensitive configuration should be stored in .env.local

# Authentication
AUTH_SESSION_KEY=aplomado_session_token
AUTH_ENCRYPTION_KEY=your_encryption_key_here
AUTH_SESSION_DURATION=86400000
API_KEY=demo-api-key-12345

# Application Configuration
APP_NAME=Aplomado Suite
APP_VERSION=1.0.0
DEFAULT_THEME=falcon-dark

# Local Storage Paths
LOCAL_DATA_PATH=./local-data
USER_PREFERENCES_PATH=./local-data/preferences
APP_DATA_PATH=./local-data/apps

# Security
ENCRYPTION_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT=86400000

# Development
DEV_MODE=false
DEBUG_LOGGING=false
